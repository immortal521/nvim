{
  "$schema": "https://raw.githubusercontent.com/LuaLS/lua-language-server/3rd/locale/en-us/setting.json",
  "runtime.version": "LuaJIT",
  "runtime.path": ["?.lua", "?/init.lua"],
  "diagnostics.globals": ["vim", "indent_type", "indent_width", "column_width"],
  "workspace.checkThirdParty": false,
  "workspace.library": [
    "${3rd}/luv/library",
    "${workspaceFolder}/lua",
    "/usr/share/nvim/runtime/lua",
    "$VIMRUNTIME",
    "$HOME/.local/share/nvim/lazy"
  ],
  "telemetry.enable": false,
  "diagnostics.disable": []
}
